rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null
        && !exists(/databases/$(database)/documents/account_deletions/$(request.auth.uid));
    }

    function canReadRoom(roomId) {
      return signedIn()
        && roomId.split('[.]').size() == 2
        && request.auth.uid.toUtf8().toBase64().replace('=', '') in roomId.split('[.]');
    }

    function canSend(senderId, receiverId) {
      return !exists(/databases/$(database)/documents/account_deletions/$(receiverId))
        && !exists(/databases/$(database)/documents/Users/$(senderId)/blocked_users/$(receiverId))
        && !exists(/databases/$(database)/documents/Users/$(receiverId)/blocked_users/$(senderId));
    }

    function validParticipants(roomId, data) {
      return data.keys().hasOnly(['participantIds'])
        && data.participantIds is list
        && data.participantIds.size() == 2
        && data.participantIds[0] is string
        && data.participantIds[1] is string
        && data.participantIds[0] != data.participantIds[1]
        && roomId == data.participantIds[0].toUtf8().toBase64().replace('=', '')
          + '.' + data.participantIds[1].toUtf8().toBase64().replace('=', '')
        && request.auth.uid in data.participantIds
        && exists(/databases/$(database)/documents/Users/$(data.participantIds[0]))
        && exists(/databases/$(database)/documents/Users/$(data.participantIds[1]));
    }

    match /Users/{userId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['uid', 'email', 'displayName'])
        && request.resource.data.uid == userId
        && request.resource.data.email == request.auth.token.email
        && (request.resource.data.displayName == null
          || request.resource.data.displayName is string);

      match /blocked_users/{blockedId} {
        allow read, delete: if signedIn() && request.auth.uid == userId;
        allow create, update: if signedIn()
          && request.auth.uid == userId
          && blockedId != userId
          && !exists(/databases/$(database)/documents/account_deletions/$(blockedId))
          && request.resource.data.keys().hasOnly(['userId', 'email', 'createdAt'])
          && request.resource.data.userId == blockedId
          && request.resource.data.email == get(/databases/$(database)/documents/Users/$(blockedId)).data.email
          && request.resource.data.createdAt == request.time;
      }
    }

    match /chat_rooms/{roomId} {
      allow read: if canReadRoom(roomId);
      allow create: if signedIn() && validParticipants(roomId, request.resource.data);
      allow update: if signedIn()
        && validParticipants(roomId, request.resource.data)
        && request.resource.data.participantIds == resource.data.participantIds;

      match /messages/{messageId} {
        function roomAfterWrite() {
          return getAfter(/databases/$(database)/documents/chat_rooms/$(roomId)).data;
        }

        allow read: if canReadRoom(roomId);
        allow create: if signedIn()
          && request.auth.uid in roomAfterWrite().participantIds
          && request.resource.data.keys().hasOnly([
            'senderID', 'senderEmail', 'receiverID', 'message', 'timestamp'
          ])
          && request.resource.data.senderID == request.auth.uid
          && request.resource.data.senderEmail == request.auth.token.email
          && request.resource.data.receiverID in roomAfterWrite().participantIds
          && request.resource.data.receiverID != request.auth.uid
          && canSend(request.auth.uid, request.resource.data.receiverID)
          && request.resource.data.message is string
          && request.resource.data.message.trim().size() > 0
          && request.resource.data.message.size() <= 4000
          && request.resource.data.timestamp == request.time;
      }
    }

    match /reports/{reportId} {
      // Reports can be created by the reporter and reviewed using Admin access.
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'reporterId', 'reportedUserId', 'roomId', 'messageId',
          'reason', 'details', 'createdAt', 'status'
        ])
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.reportedUserId != request.auth.uid
        && !exists(/databases/$(database)/documents/account_deletions/$(request.resource.data.reportedUserId))
        && exists(/databases/$(database)/documents/Users/$(request.resource.data.reportedUserId))
        && request.resource.data.roomId in [
          request.auth.uid.toUtf8().toBase64().replace('=', '') + '.'
            + request.resource.data.reportedUserId.toUtf8().toBase64().replace('=', ''),
          request.resource.data.reportedUserId.toUtf8().toBase64().replace('=', '') + '.'
            + request.auth.uid.toUtf8().toBase64().replace('=', '')
        ]
        && (request.resource.data.messageId == null
          || get(/databases/$(database)/documents/chat_rooms/$(request.resource.data.roomId)/messages/$(request.resource.data.messageId)).data.senderID
            == request.resource.data.reportedUserId)
        && request.resource.data.reason in ['Spam or scam', 'Harassment', 'Inappropriate content', 'Other']
        && request.resource.data.details is string
        && request.resource.data.details.size() <= 1000
        && request.resource.data.createdAt == request.time
        && request.resource.data.status == 'pending';
    }
  }
}
